# .clauderc - Pro-Vibe-Dev Phase 3 with Multi-CLI Support

[project]
name = "Pro-Vibe-Dev SwiftUI Project"
description = "Professional SwiftUI development with intelligent coordination and automatic tracking"
language = "swift"
framework = "swiftui"
system = "pro_vibe_dev_phase3"

[tracking_integration]
# Full automatic tracking capabilities
automatic_task_tracking = true
feature_detection = true
knowledge_base_updates = true
progress_reporting = "real-time"
pattern_learning = true
quality_gates_auto = true

# Intelligence features
predictive_recommendations = true
architecture_analysis = true
velocity_tracking = true
quality_trend_analysis = true

[agent_organization]
# Domain-based agent structure
ui_agents_dir = "pro-vibe-dev/agents/ui-agents/"
backend_agents_dir = "pro-vibe-dev/agents/backend-agents/"
quality_agents_dir = "pro-vibe-dev/agents/quality-agents/"
coordination_agents_dir = "pro-vibe-dev/agents/coordination-agents/"

[agent_triggers]
# Context-aware automatic agent activation
accessibility = ["ui-frontend", "accessibility-expert", "accessibility-auditor"]
api = ["backend", "data-modeling", "performance-optimizer"]
testing = ["qa-testing", "tdd-enforcer", "accessibility-auditor"]
documentation = ["documentation", "code-comments"]
performance = ["performance-optimizer", "backend", "ui-frontend"]
coordination = ["task-coordinator", "sprint-planner"]
swiftui = ["ui-frontend", "accessibility-expert"]
security = ["backend", "security-expert", "tdd-enforcer"]
junior_dev = ["task-coordinator", "tdd-enforcer"]

[quality_gates]
# Automatic quality triggers based on file patterns and events
swiftui_files = ["ui-frontend", "accessibility-expert", "tdd-enforcer", "performance-optimizer"]
service_files = ["backend", "tdd-enforcer", "security-expert"]
test_files = ["qa-testing", "tdd-enforcer"]
model_files = ["backend", "data-modeling", "tdd-enforcer"]
pr_creation = ["task-coordinator", "qa-testing", "accessibility-auditor", "performance-optimizer", "documentation"]

[quality_standards]
# Professional quality thresholds
test_coverage_business_logic = 95
test_coverage_overall = 85
accessibility_standard = "WCAG_AA"
performance_threshold_ms = 100
color_contrast_ratio = 4.5

[workflows]
# Enhanced workflow processes with quality integration
create_vision_prd = "pro-vibe-dev/workflows/create-vision-prd.md"
create_tasks = "pro-vibe-dev/workflows/create-tasks.md"
task_execution = "pro-vibe-dev/workflows/task-execution.md"
quality_gates = "pro-vibe-dev/workflows/quality-gates.md"
agent_coordination = "pro-vibe-dev/workflows/agent-coordination.md"

[templates]
# Professional templates with quality standards
task_template = "pro-vibe-dev/templates/task-template.md"
prd_template = "pro-vibe-dev/templates/prd-template.md"
quality_checklist = "pro-vibe-dev/templates/quality-checklist.md"

[cli_compatibility]
# Multi-CLI support configurations
claude_code_native = true
gemini_cli_support = true
cursor_integration = true
continue_integration = true
aider_integration = true
generic_cli_support = true

[instructions]
system_prompt = """
You are working with the Pro-Vibe-Dev Phase 3 system featuring intelligent coordination, automatic tracking, and multi-CLI compatibility.

CORE WORKFLOWS:
- Use create-vision-prd.md for strategic product vision creation (8-12 minutes, anti-overengineering)
- Use create-tasks.md for converting PRDs into junior-developer-ready tasks (automatic TDD integration)
- Use task-coordinator.md for complex multi-agent coordination
- Use quality-gates.md for automatic validation throughout development

JUNIOR DEVELOPER SUPPORT:
- All tasks broken into 1-4 hour chunks with crystal-clear acceptance criteria
- Built-in TDD methodology with test templates
- Comprehensive implementation guidance with code examples
- Learning opportunities embedded in every task

AUTOMATIC INTELLIGENCE:
- Task progress tracked automatically with milestone detection
- Feature completion triggers knowledge base updates
- Quality gates auto-trigger based on file changes and development events
- Pattern learning improves recommendations over time

MULTI-CLI COMPATIBILITY:
- Works seamlessly with Claude Code (native integration)
- Compatible with Gemini CLI, Cursor, Continue, Aider, and any AI coding tool
- Universal command patterns for consistent experience across tools
- Pure markdown-based system works with any AI assistant

PROFESSIONAL STANDARDS:
- Accessibility-first SwiftUI development (WCAG AA compliance)
- Test-driven development methodology (95%+ coverage for business logic)
- Security-conscious backend implementation (Keychain storage, input validation)
- Performance optimization throughout (60fps UI, efficient async operations)

QUALITY INTEGRATION:
- Quality gates automatically trigger based on file types and development activities
- All UI work includes accessibility validation
- All backend work includes TDD compliance and security review
- Comprehensive validation before feature completion

COORDINATION PATTERNS:
- Single-domain tasks: Use specialized agents directly
- Multi-domain tasks: Use task-coordinator for orchestration
- Complex features: Full coordination with quality gate integration
- Quality issues: Automatic specialist activation

Always prioritize user value delivery while maintaining professional quality through intelligent automation and junior-developer-friendly guidance.
"""